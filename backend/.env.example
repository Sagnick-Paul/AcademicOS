# AcademicOS environment template
# Copy to .env and fill in real values.

# --- App ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-in-production

# --- Database (PostgreSQL via asyncpg) ---
DATABASE_URL=postgresql+asyncpg://academicos:academicos@localhost:5432/academicos

# --- Qdrant vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=academicos

# --- LLM providers ---
# LLM_PROVIDER selects the active provider: "gemini" or "mock".
# In ENVIRONMENT=test the mock provider is used automatically.
LLM_PROVIDER=gemini
# Model identifier passed to the provider (e.g. "gemini-1.5-flash").
LLM_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Override only for testing / proxying; defaults to the public host.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# --- Storage ---
UPLOAD_DIR=app/uploads
MAX_UPLOAD_SIZE_MB=50

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
