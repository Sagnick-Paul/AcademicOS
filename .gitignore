# ============================================================
# AcademicOS - .gitignore
# ============================================================

# ----------------------------
# Python
# ----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ----------------------------
# Python Cache & Tooling
# ----------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/

# ----------------------------
# Coverage
# ----------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/

# ----------------------------
# Virtual Environments
# ----------------------------
.venv/
venv/
env/
ENV/

# ----------------------------
# Environment Variables
# ----------------------------
.env
.env.*
!.env.example

# ----------------------------
# IDEs & Editors
# ----------------------------
.vscode/
.idea/
*.swp
*.swo
*.iml

# ----------------------------
# Logs
# ----------------------------
logs/
*.log
*.out
*.err

# ----------------------------
# Runtime Uploads
# ----------------------------
backend/app/uploads/*
!backend/app/uploads/.gitkeep

backend/app/static/generated/*
!backend/app/static/generated/.gitkeep

# ----------------------------
# Alembic
# ----------------------------
backend/alembic/__pycache__/

# ----------------------------
# Databases
# ----------------------------
*.db
*.sqlite3

# ----------------------------
# Frontend (Next.js)
# ----------------------------
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/

# ----------------------------
# Package Managers
# ----------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------
# Docker
# ----------------------------
docker-compose.override.yml

# ----------------------------
# Redis / Celery
# ----------------------------
celerybeat-schedule

# ----------------------------
# Operating System Files
# ----------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ----------------------------
# Miscellaneous
# ----------------------------
*.tmp
*.temp
*.bak
*.orig

# ----------------------------
# Project-specific
# ----------------------------
graphify-out/